# Public build-time configuration. Copy to .env.local to test locally.
# Vercel: Project Settings > Environment Variables, then rebuild.
# Leave blank until accounts exist. Never put private API keys here.

# Choose GTM OR direct Google tag. GTM takes priority; configure GA4/Ads inside it.
VITE_GTM_ID=
VITE_GA4_ID=
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_LEAD_LABEL=

# The content value of the Search Console HTML verification meta tag.
VITE_SEARCH_CONSOLE_VERIFICATION=

# First-party Vercel Function (default /api/enquiry). Explicit blank disables the form.
VITE_ENQUIRY_ENDPOINT=/api/enquiry

# Server-only. Set as a Production Secret in Vercel; never prefix with VITE_.
RESEND_API_KEY=
